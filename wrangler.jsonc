{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "scarlet-peach-catalog",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
